---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';

const profile = await getEntry('profile', 'profile');
const { Content: ProfileIntro } = await render(profile);
const hasProfileIntro = Boolean(profile.body?.trim());
const latestArticles = (await getCollection('articles'))
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 1);

function formatDate(date: string) {
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(`${date}T12:00:00`));
}
---

<SiteLayout
  title={`${profile.data.name} — Profil & articles`}
  description={`Profil, parcours et publications de ${profile.data.name}.`}
>
  <section class="hero" id="presentation" aria-labelledby="profile-name">
    <div class="hero-copy">
      <p class="eyebrow">Présentation</p>
      <h1 id="profile-name">{profile.data.name}</h1>
      <p class="hero-role">{profile.data.role}</p>
      <p class="hero-location">{profile.data.location}</p>
    </div>
    <div class="hero-visual" aria-hidden={profile.data.portrait ? undefined : 'true'}>
      {profile.data.portrait ? (
        <>
          <img
            class="hero-photo"
            src={profile.data.portrait}
            alt={profile.data.portrait === '/images/portrait-placeholder.jpg' ? 'Portrait de démonstration, à remplacer' : `Portrait de ${profile.data.name}`}
          />
          {profile.data.portrait === '/images/portrait-placeholder.jpg' && <span class="photo-caption">Photo de démonstration</span>}
        </>
      ) : (
        <span class="visual-name">{profile.data.initials}</span>
      )}
    </div>
  </section>

  {hasProfileIntro && (
    <section class="intro-band" id="a-propos" aria-labelledby="about-title">
      <h2 class="section-heading" id="about-title">À propos</h2>
      <div class="profile-intro"><ProfileIntro /></div>
    </section>
  )}

  <section class="resume-section" id="parcours" aria-labelledby="resume-title">
    <div class="section-topline">
      <div><p class="section-kicker">Parcours</p><h2 class="section-heading" id="resume-title">Expériences et formation</h2></div>
    </div>
    <div class="resume-grid">
      <div class="experience-block">
        <h3 class="subsection-heading">Expériences</h3>
        {profile.data.experience.length > 0 ? (
          <div class="timeline">
            {profile.data.experience.map((item) => (
              <article class="timeline-item">
                <p class="timeline-date">{item.period}</p>
                <div>
                  <h4>{item.title}</h4>
                  <p class="timeline-place">{item.organization}</p>
                  {item.description && <p class="timeline-description">{item.description}</p>}
                  {item.details.length > 0 && (
                    <ul class="experience-details">
                      {item.details.map((detail) => <li>{detail}</li>)}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        ) : <p class="empty-state">À compléter</p>}
      </div>
      <div class="resume-side">
        <section class="education-block" aria-labelledby="education-title">
          <h3 class="subsection-heading" id="education-title">Formation</h3>
          {profile.data.education.length > 0 ? profile.data.education.map((item) => (
            <article class="education-item">
              <p class="side-date">{item.period}</p>
              <h4>{item.title}</h4>
              <p class="timeline-place">{item.organization}</p>
              {item.description && <p class="timeline-description">{item.description}</p>}
            </article>
          )) : <p class="empty-state">À compléter</p>}
        </section>
        <section class="skills-block" aria-labelledby="skills-title">
          <h3 class="subsection-heading" id="skills-title">Compétences</h3>
          {profile.data.skills.length > 0 ? (
            <ul class="skill-list">{profile.data.skills.map((skill) => <li>{skill}</li>)}</ul>
          ) : <p class="empty-state">À compléter</p>}
        </section>
      </div>
    </div>
  </section>

  <section class="hobbies-section" aria-labelledby="hobbies-title">
    <div><p class="section-kicker">En dehors du travail</p><h2 class="section-heading" id="hobbies-title">Centres d’intérêt</h2></div>
    {profile.data.hobbies.length > 0 ? (
      <ul class="hobby-list">{profile.data.hobbies.map((hobby) => <li>{hobby}</li>)}</ul>
    ) : <p class="empty-state">À compléter</p>}
  </section>

  <section class="journal-section" aria-labelledby="articles-title">
    <div class="section-topline">
      <div><p class="section-kicker">Articles</p><h2 class="section-heading" id="articles-title">Quelques publications</h2></div>
      <a class="text-link" href="/articles/">Tous les articles <span aria-hidden="true">↗</span></a>
    </div>
      <div class="post-grid">
      {latestArticles.map((article) => (
        <a class="post-card" href={`/articles/${article.id}/`}>
          <div class="post-card-meta"><span>{article.data.category}</span><time datetime={article.data.date}>{formatDate(article.data.date)}</time></div>
          <h3>{article.data.title}</h3>
          <p>{article.data.excerpt}</p>
          <span class="post-read">Lire l’article <b aria-hidden="true">↗</b></span>
        </a>
      ))}
    </div>
  </section>

</SiteLayout>

<style>
  .hero { display: grid; min-height: 360px; grid-template-columns: 1.15fr 0.85fr; align-items: center; gap: 56px; padding: 34px 0 42px; }
  .hero-copy { max-width: 590px; animation: arrive 500ms ease both; }
  .hero h1 { margin: 8px 0; font-size: 54px; font-weight: 700; line-height: 1.15; }
  .hero-role { margin: 0; color: var(--accent); font-size: 18px; font-weight: 600; }
  .hero-location { margin: 10px 0 0; color: var(--muted); font-size: 14px; }
  .hero-visual { position: relative; justify-self: end; width: min(100%, 380px); height: 280px; overflow: hidden; border: 2px solid transparent; border-radius: 12px; background: linear-gradient(var(--panel), var(--panel)) padding-box, linear-gradient(135deg, var(--accent), var(--accent-violet) 58%, var(--accent-cyan)) border-box; box-shadow: 0 14px 40px #090a171f; animation: arrive 650ms 80ms ease both; }
  .hero-photo { position: absolute; inset: 2px; width: calc(100% - 4px); height: calc(100% - 4px); border-radius: 9px; object-fit: cover; }
  .photo-caption { position: absolute; right: 12px; bottom: 12px; padding: 5px 9px; border-radius: 4px; background: #17181de8; color: #fff; font-size: 11px; }
  .visual-name { z-index: 1; color: var(--accent); font-size: 150px; font-weight: 700; line-height: 1; }
  .intro-band { display: grid; grid-template-columns: 190px 1fr; gap: 48px; align-items: start; padding: 38px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .intro-band .section-kicker { padding-top: 5px; }
  .profile-intro p { max-width: 760px; margin: 0; font-size: 18px; line-height: 1.75; }
  .resume-section, .journal-section { padding: 72px 0; }
  .section-topline { display: flex; justify-content: space-between; gap: 25px; align-items: end; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
  .section-topline .section-heading { margin-top: 7px; }
  .section-note { margin: 0; color: var(--muted); font-size: 13px; }
  .resume-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 9%; padding-top: 32px; }
  .subsection-heading { margin: 0 0 20px; font-size: 20px; font-weight: 600; }
  .resume-grid-single { grid-template-columns: minmax(0, 1fr); }
  .timeline { margin-left: 4px; padding-left: 22px; border-left: 2px solid var(--accent-soft); }
  .timeline-item { position: relative; display: grid; grid-template-columns: 145px 1fr; gap: 22px; padding: 0 0 28px; }
  .timeline-item::before { position: absolute; top: 6px; left: -29px; width: 10px; height: 10px; border: 2px solid var(--paper); border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); content: ''; }
  .timeline-date, .side-date { margin: 3px 0 0; color: var(--accent-cool); font-size: 14px; }
  .timeline-item h4, .education-item h4 { margin: 0; font-size: 16px; font-weight: 700; }
  .timeline-place { margin: 2px 0 8px; color: var(--muted); font-size: 14px; }
  .timeline-description { max-width: 440px; margin: 0; color: var(--muted); font-size: 14px; }
  .empty-state { margin: 0; color: var(--muted); font-size: 14px; }
  .experience-details { margin: 10px 0 0; padding-left: 20px; color: var(--muted); font-size: 14px; }
  .experience-details li + li { margin-top: 5px; }
  .resume-side { display: grid; grid-template-columns: 1fr; gap: 32px; }
  .education-item { margin-bottom: 18px; }
  .education-item h4 { margin-top: 5px; }
  .skill-list { margin: 0; padding: 0; list-style: none; }
  .skill-list li { padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .skill-list li::before { margin-right: 9px; color: var(--accent); content: '✓'; font-weight: 700; }
  .hobbies-section { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; padding: 36px 0; border-top: 1px solid var(--line); }
  .hobbies-section .section-heading { margin-top: 6px; font-size: 23px; }
  .hobby-list { display: flex; flex-wrap: wrap; gap: 10px 24px; margin: 0; padding: 0; list-style: none; }
  .hobby-list li { color: var(--muted); font-size: 15px; }
  .hobby-list li::before { display: inline-block; width: 7px; height: 7px; margin: 0 9px 1px 0; border-radius: 2px; background: var(--warm); content: ''; transform: rotate(45deg); }
  .journal-section { padding-top: 0; }
  .post-grid { padding-top: 6px; }
  .post-card { display: grid; grid-template-columns: 140px minmax(0, 1fr) auto; gap: 0 25px; align-items: start; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .post-card-meta { display: flex; flex-direction: column; gap: 4px; grid-column: 1; grid-row: 1 / span 3; color: var(--muted); font-size: 12px; }
  .post-card-meta span { color: var(--accent-cool); }
  .post-card h3 { grid-column: 2; grid-row: 1; margin: 0 0 5px; font-size: 19px; font-weight: 600; line-height: 1.4; }
  .post-card > p { grid-column: 2; grid-row: 2; max-width: 560px; margin: 0; color: var(--muted); font-size: 13px; }
  .post-read { grid-column: 3; grid-row: 1 / span 2; margin-top: 2px; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .post-read b { margin-left: 5px; color: var(--accent); }
  @keyframes arrive { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 760px) {
    .hero { min-height: 0; grid-template-columns: 1fr 0.85fr; gap: 32px; padding: 55px 0 60px; }
    .hero-visual { justify-self: stretch; width: 100%; height: 260px; }
    .visual-name { font-size: 120px; }
    .hero h1 { font-size: 54px; }
    .intro-band { grid-template-columns: 140px 1fr; gap: 28px; }
    .resume-grid { grid-template-columns: 1fr; gap: 12px; }
    .resume-side { grid-template-columns: 1fr 1fr; gap: 24px; }
    .resume-section, .journal-section { padding: 58px 0; }
    .journal-section { padding-top: 0; }
    .hobbies-section { grid-template-columns: 1fr; gap: 14px; }
  }
  @media (max-width: 480px) {
    .hero { grid-template-columns: 1fr; gap: 18px; padding: 30px 0 36px; }
    .hero h1 { font-size: 42px; }
    .hero-role { font-size: 18px; }
    .hero-visual { height: 230px; }
    .visual-name { font-size: 90px; }
    .intro-band { grid-template-columns: 1fr; gap: 12px; padding: 28px 0; }
    .profile-intro p { font-size: 16px; }
    .section-heading { font-size: 27px; }
    .section-topline { align-items: flex-start; }
    .timeline-item { grid-template-columns: 1fr; gap: 7px; }
    .resume-side { grid-template-columns: 1fr; }
    .post-card { grid-template-columns: 1fr; gap: 8px; }
    .post-card-meta, .post-card h3, .post-card > p, .post-read { grid-column: 1; grid-row: auto; }
    .post-card-meta { flex-direction: row; justify-content: space-between; }
    .post-read { margin-top: 4px; }
    .page-intro h1, .article-page h1 { font-size: 38px; }
  }
</style>