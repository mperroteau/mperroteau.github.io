---
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Prénom Nom — Profil & articles',
  description = 'Le profil, le parcours et les publications de Prénom Nom.',
} = Astro.props;
const currentPath = Astro.url.pathname;
const profile = await getEntry('profile', 'profile');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17181d" />
    <script is:inline>
      let savedTheme = null;
      try {
        savedTheme = localStorage.getItem('site-theme');
      } catch {}
      if (savedTheme === 'light' || savedTheme === 'dark') {
        document.documentElement.dataset.theme = savedTheme;
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <div class="site-shell">
      <header class="topbar">
        <a class="wordmark" href="/" aria-label={`Accueil, ${profile.data.name}`}>
          <span class="wordmark-mark">{profile.data.initials}</span>
          <span>{profile.data.name}</span>
        </a>
        <nav aria-label="Navigation principale">
          <a class="nav-link" href="/#presentation" aria-current={currentPath === '/' ? 'page' : undefined}>Présentation</a>
          {(profile.data.experience.length > 0 || profile.data.education.length > 0) && (
            <a class="nav-link" href="/#parcours">Parcours</a>
          )}
          <a class:list={['nav-link', { active: currentPath.startsWith('/articles')}]} href="/articles/" aria-current={currentPath.startsWith('/articles') ? 'page' : undefined}>Articles</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Thème sombre" aria-pressed="true" title="Passer au thème clair">
            <span aria-hidden="true">☼</span>
          </button>
        </nav>
      </header>

      <main>
        <a id="main-content" class="main-content-target" href="#main-content" tabindex="-1" aria-label="Début du contenu principal"></a>
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} {profile.data.name}</span>
        <span>Présentation personnelle</span>
      </footer>
    </div>
    <script is:inline>
      const skipLink = document.querySelector('.skip-link');
      const themeButton = document.querySelector('[data-theme-toggle]');
      const themeIcon = themeButton?.querySelector('span');
      const themeColor = document.querySelector('meta[name="theme-color"]');

      skipLink?.addEventListener('focus', () => {
        skipLink.classList.add('is-visible');
        skipLink.style.transform = 'translateY(0)';
      });
      skipLink?.addEventListener('blur', () => {
        skipLink.classList.remove('is-visible');
        skipLink.style.removeProperty('transform');
      });

      function updateTheme(theme) {
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('site-theme', theme);
        } catch {}
        const nextTheme = theme === 'dark' ? 'clair' : 'sombre';
        themeButton?.setAttribute('aria-label', `Thème ${theme === 'dark' ? 'sombre' : 'clair'}`);
        themeButton?.setAttribute('aria-pressed', String(theme === 'dark'));
        themeButton?.setAttribute('title', `Passer au thème ${nextTheme}`);
        themeColor?.setAttribute('content', theme === 'dark' ? '#17181d' : '#ffffff');
        if (themeIcon) themeIcon.textContent = theme === 'dark' ? '☼' : '☾';
      }

      updateTheme(document.documentElement.dataset.theme || 'dark');
      themeButton?.addEventListener('click', () => {
        updateTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --paper: #17171f;
    --ink: #f5f4fa;
    --muted: #c1bacb;
    --line: #3f364b;
    --accent: #0083ef;
    --heading-secondary: #f08acb;
    --accent-violet: #bd6dff;
    --accent-cyan: #45d8cd;
    --accent-soft: #292e5b;
    --accent-cool: #c6a9ff;
    --warm: #bd6dff;
    --panel: #20212d;
    --panel-strong: #2b2541;
    --page-wash: #23203c;
  }

  :root[data-theme='light'] {
    color-scheme: light;
    --paper: #ffffff;
    --ink: #202127;
    --muted: #615a68;
    --line: #e5dce9;
    --accent: #2d4fdb;
    --heading-secondary: #a53d80;
    --accent-violet: #783ac5;
    --accent-cyan: #176f82;
    --accent-soft: #ecebff;
    --accent-cool: #59459e;
    --warm: #783ac5;
    --panel: #f7f6fc;
    --panel-strong: #efeafa;
    --page-wash: #f3efff;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: linear-gradient(125deg, var(--paper) 0%, var(--page-wash) 55%, var(--paper) 100%);
    background-attachment: fixed;
    color: var(--ink);
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    transition: background-color 200ms ease, color 200ms ease;
  }
  h1, h2 { color: var(--accent); }
  h3, h4 { color: var(--heading-secondary); }
  a { color: inherit; text-decoration: none; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--warm); outline-offset: 3px; }
  .skip-link {
    position: fixed;
    z-index: 20;
    top: 12px;
    left: 12px;
    padding: 10px 14px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--accent), var(--accent-violet) 58%, var(--accent-cyan));
    color: var(--paper);
    font-weight: 700;
    transform: translateY(-160%);
  }
  .skip-link.is-visible { transform: translateY(0); }
  .main-content-target { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .site-shell { width: min(1160px, calc(100% - 64px)); margin: 0 auto; }
  .topbar {
    min-height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  .wordmark { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 700; }
  .wordmark-mark {
    display: grid;
    width: 34px;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    letter-spacing: 0;
  }
  .topbar nav { display: flex; align-items: center; gap: 30px; }
  .nav-link { color: var(--muted); font-size: 13px; font-weight: 600; transition: color 160ms ease; }
  .nav-link:hover, .nav-link.active { color: var(--ink); }
  .text-link span { color: var(--accent); }
  .theme-toggle {
    display: grid;
    width: 38px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    cursor: pointer;
    font-size: 19px;
    line-height: 1;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .theme-toggle:hover { border-color: transparent; background: linear-gradient(135deg, var(--accent), var(--accent-violet) 58%, var(--accent-cyan)); color: #fff; }
  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 27px 0 34px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 12px;
  }
  .site-footer a { color: var(--ink); }
  .eyebrow, .section-kicker {
    margin: 0;
    color: var(--heading-secondary);
    font-size: 13px;
    font-weight: 600;
  }
  .eyebrow::before, .section-kicker::before {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 9px 1px 0;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--accent), var(--accent-violet) 58%, var(--accent-cyan));
    content: '';
    transform: rotate(45deg);
  }
  .section-heading { margin: 0; font-size: 30px; font-weight: 600; line-height: 1.3; }
  .text-link { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 700; }
  .text-link:hover { color: var(--accent); }
  .page-intro { padding: 72px 0 52px; border-bottom: 1px solid var(--line); }
  .page-intro h1 { max-width: 760px; margin: 14px 0; font-size: 52px; font-weight: 600; line-height: 1.2; }
  .page-intro p:last-child { max-width: 560px; margin: 0; color: var(--muted); font-size: 16px; }
  .article-list { padding: 8px 0 72px; }
  .article-row {
    display: grid;
    grid-template-columns: 135px minmax(0, 1fr) 24px;
    gap: 24px;
    align-items: start;
    padding: 25px 0;
    border-bottom: 1px solid var(--line);
  }
  .article-meta { color: var(--muted); font-size: 12px; }
  .article-meta span { display: block; margin-top: 4px; color: var(--accent-cool); }
  .article-row h2 { margin: 0 0 6px; font-size: 21px; font-weight: 600; line-height: 1.4; }
  .article-row p { max-width: 590px; margin: 0; color: var(--muted); font-size: 13px; }
  .article-arrow { padding-top: 2px; color: var(--accent); font-size: 18px; }
  .article-row:hover h2 { color: var(--accent); }
  .article-page { max-width: 760px; margin: 0 auto; padding: 68px 0 82px; }
  .back-link { display: inline-block; margin-bottom: 48px; color: var(--muted); font-size: 12px; font-weight: 700; }
  .back-link:hover { color: var(--accent); }
  .article-page h1 { margin: 14px 0; font-size: 48px; font-weight: 600; line-height: 1.2; }
  .article-deck { margin: 0 0 42px; color: var(--muted); font-size: 17px; }
  .article-copy { max-width: 650px; }
  .article-copy p { margin: 0 0 22px; font-size: 16px; line-height: 1.9; }
  .article-end { margin-top: 52px; padding-top: 22px; border-top: 1px solid var(--line); }

  @media (max-width: 680px) {
    .site-shell { width: min(100% - 36px, 520px); }
    .topbar { min-height: 72px; gap: 16px; }
    .topbar nav { gap: 16px; }
    .nav-link { font-size: 12px; }
    .site-footer { flex-direction: column; gap: 7px; }
    .page-intro { padding: 54px 0 38px; }
    .article-row { grid-template-columns: 1fr 22px; gap: 8px 12px; padding: 22px 0; }
    .article-meta { grid-column: 1; }
    .article-row > a:first-of-type { grid-column: 1; grid-row: 2; }
    .article-arrow { grid-column: 2; grid-row: 1 / span 2; }
    .article-page { padding: 48px 0 60px; }
    .back-link { margin-bottom: 36px; }
    .page-intro h1, .article-page h1 { font-size: 42px; }
  }

  @media (max-width: 420px) {
    .site-shell { width: min(100% - 28px, 520px); }
    .topbar { gap: 4px; }
    .topbar nav { gap: 7px; }
    .wordmark { gap: 7px; font-size: 11px; }
    .wordmark-mark { width: 30px; }
    .nav-link { font-size: 11px; white-space: nowrap; }
    .theme-toggle { width: 32px; }
  }

  @media (max-width: 360px) {
    .wordmark > span:last-child { display: none; }
    .topbar nav { gap: 8px; }
    .nav-link { font-size: 10px; }
    .theme-toggle { width: 30px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>